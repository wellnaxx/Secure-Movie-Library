# =========================
# Database
# =========================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=movie_library
DB_USER=root
DB_PASSWORD=YOUR_PASSWORD
DB_CONNECT_TIMEOUT=5

# =========================
# JWT / Auth
# =========================
JWT_SECRET_KEY=YOUR_JWT_SECURITY_KEY_THAT_HAS_TO_BE_32_CHARS
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7

# =========================
# OMDb
# =========================
OMDB_API_KEY=your_omdb_api_key
OMDB_BASE_URL=https://www.omdbapi.com/
OMDB_TIMEOUT_SECONDS=10

# =========================
# Logging
# =========================
LOG_LEVEL=INFO
# Optional file destination, relative to the working directory or absolute.
# Rotates at 10 MiB with five backups. Blank means stdout only.
LOG_FILE=
